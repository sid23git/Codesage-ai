# ---------------------------------------------------------------------------
# docker-compose.yml environment -- local production-parity stack only.
#
# This is DISTINCT from backend/.env.example (used when running the
# backend directly with `uvicorn --reload`, outside a container) and
# frontend/.env.local.example (used with `npm run dev`). This file's
# values are consumed by docker-compose.yml itself, which then passes
# them into the backend/frontend containers.
#
# Usage:
#   cp .env.example .env
#   # edit .env: set SECRET_KEY and POSTGRES_PASSWORD to real local values
#   docker compose up --build
#
# Never commit the resulting .env file (it's gitignored) -- this .example
# file is the only one meant to be tracked.
# ---------------------------------------------------------------------------

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A throwaway local value is fine here -- this only ever signs JWTs issued
# by your own local containers, never a real deployment.
SECRET_KEY=

# Required. Any local value works -- this is the password the `db`
# container creates its `codesage` role with, and what the `backend`
# container uses to connect to it. Not a real secret; still don't reuse
# a password you use anywhere else.
POSTGRES_PASSWORD=

# Optional -- database name/user if you want something other than the
# defaults baked into docker-compose.yml (both default to `codesage`).
# POSTGRES_DB=codesage
# POSTGRES_USER=codesage

# Optional -- a GitHub Personal Access Token, only needed if you're
# testing against enough real repository ingestions to hit GitHub's
# 60 requests/hour unauthenticated limit. Never commit a real token.
# GITHUB_TOKEN=ghp_your_token_here

# Optional -- by default the stack runs entirely on mock LLM/embedding
# providers (no network calls, no cost, deterministic). Set these only to
# exercise a real provider locally; never commit a real key.
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
