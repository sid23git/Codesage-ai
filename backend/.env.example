# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=codesage-api
# development | staging | production. DEBUG=true is REJECTED at startup
# when APP_ENV=production (see app/core/config.py) -- that combination
# exposes /docs, logs raw SQL, and opens CORS to all origins with
# credentials, so it's enforced rather than left as a deploy checklist item.
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
# 'text' (human-readable, for local dev) or 'json' (structured, one object
# per line -- use this for any real deployment so the hosting platform's
# log search can actually filter by field).
LOG_FORMAT=text
SECRET_KEY=change-me-before-deploying-to-any-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Whether POST /auth/register accepts new accounts (default: true). Set to
# false on a deployed instance after creating your own account, to close
# public registration without removing the endpoint's code.
# REGISTRATION_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Per-IP request limits on auth and AI/ingestion endpoints, enforced
# in-process (no Redis) -- see app/core/rate_limit.py for the trade-offs.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_ASSISTANT=20/minute
# RATE_LIMIT_INGEST=5/minute

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Either supply DATABASE_URL directly, or supply individual DB_* variables.
# DATABASE_URL takes precedence when both are provided.
# ---------------------------------------------------------------------------
# Option A — full DSN (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Option B — individual components (convenient for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codesage
DB_USER=codesage
DB_PASSWORD=change-me

# Connection pool (per worker process). Keep these low when DATABASE_URL
# points at a managed Postgres provider's pooled endpoint (e.g. Neon/
# Supabase PgBouncer) -- those enforce their own low connection ceilings.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# Set to 0 when DATABASE_URL points at a transaction-mode connection
# pooler (PgBouncer and similar) -- those don't support asyncpg's
# server-side prepared statements persisting across pooled connections.
# DB_STATEMENT_CACHE_SIZE=100

# ---------------------------------------------------------------------------
# GitHub Integration
# ---------------------------------------------------------------------------
# Optional — set to a GitHub Personal Access Token (PAT) to raise the API
# rate limit from 60 requests/hour (unauthenticated) to 5 000 requests/hour.
# Do NOT commit a real token here; use a secrets manager in production.
# GITHUB_TOKEN=ghp_your_token_here

# Timeout in seconds for outbound GitHub API HTTP requests (default: 10).
# GITHUB_REQUEST_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Repository Ingestion & Limits
# ---------------------------------------------------------------------------
# Maximum number of source files discovered per repository (default: 2000)
# INGESTION_MAX_FILE_COUNT=2000

# Maximum uncompressed repository size in bytes (default: 104857600 = 100 MB)
# INGESTION_MAX_REPO_SIZE_BYTES=104857600

# Maximum individual source file size in bytes (default: 2097152 = 2 MB)
# INGESTION_MAX_SINGLE_FILE_SIZE_BYTES=2097152

# Maximum downloaded compressed archive size in bytes (default: 52428800 = 50 MB)
# INGESTION_MAX_ARCHIVE_SIZE_BYTES=52428800

# Timeout in seconds for repository ingestion operations (default: 60.0)
# INGESTION_TIMEOUT_SECONDS=60.0

# Maximum number of ingestion pipelines allowed to run at once,
# process-wide -- each one holds a full downloaded archive in memory
# (default: 2). Callers beyond this limit simply wait their turn.
# INGESTION_MAX_CONCURRENT=2

# ---------------------------------------------------------------------------
# RAG & Embeddings
# ---------------------------------------------------------------------------
# Embedding provider to use: 'mock' (default, no network/API key required),
# 'voyage' (requires VOYAGE_API_KEY below), or 'openai' (requires
# OPENAI_API_KEY below).
# EMBEDDING_PROVIDER=mock

# Model identifier passed to the configured embedding provider
# (default: voyage-code-4).
# EMBEDDING_MODEL=voyage-code-4

# Output vector dimension -- MUST match code_chunks.embedding's pgvector
# column width (see alembic migration 0006) (default: 1024).
# EMBEDDING_DIMENSIONS=1024

# Required if EMBEDDING_PROVIDER=voyage. Do NOT commit a real key here; use
# a secrets manager in production.
# VOYAGE_API_KEY=pa-your-key-here

# Required if EMBEDDING_PROVIDER=openai. Do NOT commit a real key here.
# OPENAI_API_KEY=sk-your-key-here

# Timeout in seconds for outbound embedding provider requests (default: 60.0)
# EMBEDDING_REQUEST_TIMEOUT_SECONDS=60.0

# Automatic SDK-level retries on transient failures (default: 3)
# EMBEDDING_MAX_RETRIES=3

# Hard cap on embedding tokens spent per single ingestion run -- fails
# closed with EmbeddingBudgetExceededError once reached, rather than
# allowing unbounded spend on a small production deployment (default:
# 2000000).
# EMBEDDING_MAX_TOKENS_PER_INGESTION=2000000

# Voyage provider only. Maximum estimated tokens per individual embedding
# API request -- large batches are split across multiple requests to stay
# under this. Default is conservative, well under the ~10,000 tokens/minute
# ceiling observed on a free-tier Voyage account with no payment method on
# file; raise it once a payment method / higher tier is added (default: 8000).
# EMBEDDING_MAX_TOKENS_PER_REQUEST=8000

# Voyage provider only. When a batch must be split across multiple
# requests, consecutive requests are paced to stay at or under this many
# per minute (a single-request batch is never delayed). Default matches
# the observed free-tier requests-per-minute ceiling (default: 3).
# EMBEDDING_MAX_REQUESTS_PER_MINUTE=3

# ---------------------------------------------------------------------------
# LLM Orchestration (Milestone 6)
# ---------------------------------------------------------------------------
# LLM provider to use: 'mock' (default, no network/API key required) or
# 'anthropic' (requires ANTHROPIC_API_KEY below).
# LLM_PROVIDER=mock

# Model identifier passed to the configured LLM provider (default: claude-sonnet-5-5)
# LLM_MODEL=claude-sonnet-5-5

# Required if LLM_PROVIDER=anthropic. Do NOT commit a real key here; use a
# secrets manager in production.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Timeout in seconds for outbound LLM provider requests (default: 60.0)
# LLM_REQUEST_TIMEOUT_SECONDS=60.0

# Maximum tokens the LLM may generate per response (default: 2000)
# LLM_MAX_OUTPUT_TOKENS=2000

# Hard upper bound, in tokens, on the assembled input prompt: conversation
# history + retrieved evidence + current message (default: 12000)
# LLM_CONTEXT_TOKEN_BUDGET=12000

# Maximum number of prior conversation messages considered per turn (default: 8)
# LLM_MAX_HISTORY_MESSAGES=8

# Minimum fused retrieval score a chunk must meet to be used as evidence;
# below this, the assistant returns an insufficient-evidence response
# instead of answering from unsupported general knowledge (default: 0.11,
# calibrated for voyage-code-4 -- re-tune if the embedding model changes)
# LLM_MIN_RELEVANCE_SCORE=0.11

