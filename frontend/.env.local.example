# Server-only -- never exposed to the browser (no NEXT_PUBLIC_ prefix).
# The browser only ever calls same-origin /api/bff/*; only this Next.js
# server process talks to FastAPI directly (server-to-server, not subject
# to browser CORS).
BACKEND_URL=http://localhost:8000

# Session cookie configuration for the BFF auth layer (see lib/server/session.ts).
SESSION_COOKIE_NAME=cs_session
# Must mirror the backend's ACCESS_TOKEN_EXPIRE_MINUTES * 60 (default
# 1440 min = 86400s). This is a documented coupling, not dynamically
# discovered -- update both sides together if the backend's token
# lifetime changes.
SESSION_COOKIE_MAX_AGE_SECONDS=86400
